{
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": ["Inter", "sans-serif"],
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "heading": {
      "$value": { "fontFamily": "{font.family.base}", "fontSize": "{size.xl}", "fontWeight": 700, "lineHeight": 1.2 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "#00000033",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "layered": {
      "$value": [
        { "color": "{color.shadow}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000020", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "inset": false }
      ]
    }
  },
  "border": {
    "$type": "border",
    "default": { "$value": { "color": "{color.border}", "width": { "value": 1, "unit": "px" }, "style": "solid" } }
  },
  "transition": {
    "$type": "transition",
    "fade": {
      "$value": { "duration": "{motion.fast}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": [0.4, 0, 0.2, 1] }
    }
  },
  "stroke": {
    "$type": "strokeStyle",
    "dashed": { "$value": { "dashArray": [{ "value": 4, "unit": "px" }, { "value": 2, "unit": "px" }], "lineCap": "round" } }
  },
  "gradient": {
    "$type": "gradient",
    "fade": { "$value": [{ "color": "#ffffff", "position": 0 }, { "color": "#000000", "position": 1 }] }
  },
  "inferred": {
    "shadow": { "$value": [{ "offsetX": "0px", "blur": "4px", "color": "#0003" }] }
  }
}
