{
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "black": { "$value": "#000000" },
    "palette": {
      "brand": {
        "solid": { "$value": "{color.white}" },
        "subtle": { "$value": "{color.white}" }
      },
      "danger": { "solid": { "$value": "{color.black}" } }
    },
    "surface": { "base": { "$value": "{color.white}", "$description": "Page background" } },
    "fg": { "base": { "$value": "{color.black}" } }
  },
  "legacy": { "$type": "color", "old-blue": { "$value": "{color.white}" } }
}
